<?xml version="1.0" encoding="utf-8"?>
<!--
    Debug builds only; this file replaces main/res/xml/network_security_config.xml for the
    debug variant. A TrackBoard server under development is plain HTTP on the emulator's host
    (10.0.2.2) or the developer's LAN address, neither of which is known in advance, so
    cleartext is allowed everywhere here. Release builds keep the main config: cleartext only
    to the ESP32, which means a TrackBoard server must be HTTPS.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
